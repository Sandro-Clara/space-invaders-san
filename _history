ever)\n","pxt.json":"{\n    \"name\": \"Invasores do Espaço\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"smarthome-kit\": \"github:tinkertanker/pxt-smarthome#v2.2.2\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"targetVersions\": {\n        \"branch\": \"v6.0.28\",\n        \"tag\": \"v6.0.28\",\n        \"commits\": \"https://github.com/microsoft/pxt-microbit/commits/9d308fa3c282191768670a6558e4df8af2d715cf\",\n        \"target\": \"6.0.28\",\n        \"pxt\": \"9.0.19\"\n    },\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1727136837553,"editorVersion":"7.0.42","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"Llqob4)@*(I4z$tOlpI1\">nave</variable><variable id=\"B3!4+,T0zMDWAOPgKKjc\">sprite</variable><variable id=\"CXNt_-ZO7L`mDQ9RGQvX\">shoot</variable><variable id=\"-l%qU%/a|xwd337:2MZZ\">enemy</variable></variables><block type=\"pxt-on-start\" x=\"-668\" y=\"-592\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"Llqob4)@*(I4z$tOlpI1\">nave</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"game_create_sprite\"><value name=\"x\"><shadow type=\"math_number\"><field name=\"NUM\">2</field></shadow></value><value name=\"y\"><shadow type=\"math_number\"><field name=\"NUM\">4</field></shadow></value></block></value><next><block type=\"game_set_score\"><value name=\"points\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value></block></next></block></statement></block><block type=\"device_button_event\" x=\"-1148\" y=\"-382\"><field name=\"NAME\">Button.A</field><statement name=\"HANDLER\"><block type=\"game_move_sprite\"><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR